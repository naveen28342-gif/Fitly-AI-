# Copy this file to `.env.local`, then add your key before running `node server.js`.
# `.env.local` is ignored by git and is loaded automatically by the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
FITLY_DATA_FILE=./data/fitly-data.json
# Supabase is the primary store when both values are set. Keep the secret key server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy Supabase projects can use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_TABLE=fitly_users
# Set true once to copy existing data/fitly-data.json records into Supabase.
SUPABASE_MIGRATE_FILE=false
COOKIE_SECURE=false
PORT=5173
